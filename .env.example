# ---- Database ----
# Default: local SQLite (zero setup). To use Postgres instead, set e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/threatdb
DATABASE_URL=sqlite:///./security.db

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Seed admin account (used by seed_admin.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ---- Detection tuning ----
LOCKDOWN_THRESHOLD=6.0
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_WINDOW_MIN=10
REQUEST_BURST_LIMIT=60
REQUEST_BURST_WINDOW_MIN=1
RESOURCE_ACCESS_LIMIT=8
RESOURCE_ACCESS_WINDOW_MIN=2

# ---- Hardening ----
# development: weak config only warns.  production: weak secrets/passwords refuse to start.
APP_ENV=development
# Comma-separated origins allowed to call the API (no wildcard).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reverse-proxy IPs whose X-Forwarded-For is trusted. Leave empty if not behind a proxy.
TRUSTED_PROXIES=
# DEV ONLY: lets the VaultApp demo set its own IP (needed for the IP-change demo). Never true in production.
ALLOW_CLIENT_IP_HEADER=true
# Keys your real apps send as X-App-Key to /api/auth-events/login-attempt (comma-separated). Empty = a dev key is generated.
APP_API_KEYS=
# Fake accounts nobody legitimate uses; any attempt on one blocks that client.
DECOY_USERNAMES=svc_backup,test_admin,j.wilson.old,jessica.patel
# step_up (default: ask for re-verification on IP change) or lock (hard lock).
IP_CHANGE_POLICY=step_up
ML_CONTAMINATION=0.01
DEMO_MODE=false
ENABLE_HIBP=false
WEBHOOK_URL=

# ---- CYBERMIND AI (optional intelligence workflow) ----
# Provide at least one key. Gemini is the default model; select a Groq/Llama
# model in the CYBERMIND AI page when using GROQ_API_KEY.
GEMINI_API_KEY=
GROQ_API_KEY=
CYBERMIND_MODEL=gemini-1.5-flash
# Kept separate from the threat-detection SQLite/Postgres database.
CYBERMIND_CHROMA_DIR=./data/cybermind_chroma
CYBERMIND_MAX_UPLOAD_MB=20
